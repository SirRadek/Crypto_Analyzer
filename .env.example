# Example configuration for Crypto Analyzer.
# Copy this file to `.env` and adjust the values to match your environment.

APP_CONFIG_FILE=config/app.yaml

# Core pipeline parameters
SYMBOL=BTCUSDT
INTERVAL=15m
FORWARD_STEPS=8
CPU_LIMIT=0

# Storage configuration
DATABASE_URL=sqlite:///data/crypto_data.sqlite
DB_URL=sqlite:///data/crypto_data.sqlite
DB_PATH=data/crypto_data.sqlite
TABLE_PRED=predictions

# Exchange access (leave empty if not required)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# API keys are optional; leave empty if not used.
GLASSNODE_API_KEY=
WHALE_API_KEY=
